# Secrets and local environment files: never commit
.env
.env.*
.envrc
.envrc.local

# The file blob store's default folder (LOCAL_DATA_DIR, used only without a data bucket): never commit
data/local/*

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / CDK / Vite
node_modules/
cdk.out/
infra/build/
web/dist/
*.tsbuildinfo

# Tooling
.DS_Store
.idea/
.vscode/

# local mirror of the ontologies bucket (ONTOLOGIES_CACHE_DIR default outside Lambda)
.cache/

# Logs
*.log
