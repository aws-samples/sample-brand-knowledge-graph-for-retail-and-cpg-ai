@prefix dcterms: <http://purl.org/dc/terms/> .

@prefix fo: <http://example.org/multimodal-ai-knowledge-graph/fashion#> .

@prefix owl: <http://www.w3.org/2002/07/owl#> .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix hf: <http://example.org/multimodal-ai-knowledge-graph/home#> .



<http://example.org/multimodal-ai-knowledge-graph/home> a owl:Ontology ;

    rdfs:label "Home furnishings ontology (sample)"@en ;

    dcterms:creator "Amazon Web Services (sample code, MIT-0)" ;

    rdfs:comment "A small sample ontology written by hand for this workshop, in the same shape as the fashion ontology: kinds of furnishing in a hierarchy, families of detail with their allowed values, furniture parts, and a graph-only schema with the brand's curatorial relation (what is placed together in a room). Not a standard; extend it for a real catalog."@en ;

    owl:versionInfo "0.1.0" .



fo:visual a owl:AnnotationProperty ;

    rdfs:label "visual concept"@en ;

    rdfs:comment "false for schema concepts that cannot be observed in an image (used to exclude them from classification prompts)."@en .



# ---------------------------------------------------------------- kinds

