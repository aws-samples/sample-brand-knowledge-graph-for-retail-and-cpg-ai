        owl:NamedIndividual ;
    rdfs:label "geometric"@en ;
    skos:prefLabel "geometric"@en .

hf:pattern_textured a hf:Pattern,
        owl:NamedIndividual ;
    rdfs:label "textured"@en ;
    skos:prefLabel "textured"@en .

hf:Scale a owl:Class ;
    rdfs:label "scale"@en ;
    rdfs:subClassOf hf:Attribute ;
    skos:prefLabel "scale"@en .

hf:hasScale a owl:ObjectProperty ;
    rdfs:label "hasScale"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( hf:Seating hf:Table hf:Storage hf:Bed ) ] ;
    rdfs:range hf:Scale ;
    rdfs:subPropertyOf hf:hasAttribute .

hf:scale_compact a hf:Scale,
        owl:NamedIndividual ;
    rdfs:label "compact"@en ;
    skos:prefLabel "compact"@en .

hf:scale_standard a hf:Scale,
        owl:NamedIndividual ;
    rdfs:label "standard"@en ;
    skos:prefLabel "standard"@en .

hf:scale_oversized a hf:Scale,
        owl:NamedIndividual ;
    rdfs:label "oversized"@en ;
    skos:prefLabel "oversized"@en .

hf:Room a owl:Class ;
    rdfs:label "room"@en ;
    rdfs:subClassOf hf:Attribute ;
    skos:prefLabel "room"@en .

hf:hasRoom a owl:ObjectProperty ;
    rdfs:label "hasRoom"@en ;
    rdfs:domain hf:Furnishing ;
    rdfs:range hf:Room ;
    rdfs:subPropertyOf hf:hasAttribute .

hf:room_living-room a hf:Room,
        owl:NamedIndividual ;
    rdfs:label "living room"@en ;
    skos:prefLabel "living room"@en .

hf:room_dining-room a hf:Room,
        owl:NamedIndividual ;
    rdfs:label "dining room"@en ;
    skos:prefLabel "dining room"@en .

hf:room_bedroom a hf:Room,
        owl:NamedIndividual ;
    rdfs:label "bedroom"@en ;
    skos:prefLabel "bedroom"@en .

hf:room_home-office a hf:Room,
        owl:NamedIndividual ;
    rdfs:label "home office"@en ;
    skos:prefLabel "home office"@en .

hf:room_entryway a hf:Room,
        owl:NamedIndividual ;
    rdfs:label "entryway"@en ;
    skos:prefLabel "entryway"@en .

hf:room_outdoor a hf:Room,
        owl:NamedIndividual ;
    rdfs:label "outdoor"@en ;
    skos:prefLabel "outdoor"@en .


# ---------------------------------------------------------------- the brand graph's schema (not shown to the vision model)

hf:RoomScene a owl:Class ;
    rdfs:label "RoomScene"@en ;
    fo:visual false ;
    rdfs:comment "A styled room the brand shows: catalog or showroom photography (home's look)."@en ;
    skos:prefLabel "RoomScene"@en .

hf:Item a owl:Class ;
    rdfs:label "Item"@en ;
    fo:visual false ;
    rdfs:comment "One piece as it appears in a room scene or a product shot."@en ;
    skos:prefLabel "Item"@en .

hf:Brand a owl:Class ;
    rdfs:label "Brand"@en ;
    fo:visual false ;
    rdfs:comment "The brand."@en ;
    skos:prefLabel "Brand"@en .

hf:Article a owl:Class ;
    rdfs:label "Article"@en ;
    fo:visual false ;
    rdfs:comment "An editorial text: a styling guide, a journal post."@en ;
    skos:prefLabel "Article"@en .

hf:Statement a owl:Class ;
    rdfs:label "Statement"@en ;
    fo:visual false ;
    rdfs:comment "One claim of an article, about a room scene or a piece."@en ;
    skos:prefLabel "Statement"@en .

hf:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    fo:visual false ;
    rdfs:comment "The pieces in a room scene."@en ;
    rdfs:domain hf:RoomScene ;
    rdfs:range hf:Item .

hf:isCategory a owl:ObjectProperty ;
    rdfs:label "is category"@en ;
    fo:visual false ;
    rdfs:comment "The kind of furnishing an item is."@en ;
    rdfs:domain hf:Item ;
    rdfs:range hf:Furnishing .

hf:hasStatement a owl:ObjectProperty ;
    rdfs:label "has statement"@en ;
    fo:visual false ;
    rdfs:comment "The statements of an article."@en ;
    rdfs:domain hf:Article ;
    rdfs:range hf:Statement .

hf:illustrates a owl:ObjectProperty ;
    rdfs:label "illustrates"@en ;
    fo:visual false ;
    rdfs:comment "The room scene a statement is about."@en ;
    rdfs:domain hf:Statement ;
    rdfs:range hf:RoomScene .

hf:placedWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "placed with"@en ;
    fo:visual false ;
    rdfs:comment "Kind-level styling rule: pieces of these kinds are shown together in a room."@en ;
    rdfs:domain hf:Furnishing ;
    rdfs:range hf:Furnishing .


# ---------------------------------------------------------------- a few of the brand's rules, as examples

hf:Sofa hf:placedWith hf:CoffeeTable .

hf:Sofa hf:placedWith hf:Rug .

hf:Armchair hf:placedWith hf:SideTable .

hf:DiningTable hf:placedWith hf:Pendant .

hf:BedFrame hf:placedWith hf:Nightstand .
