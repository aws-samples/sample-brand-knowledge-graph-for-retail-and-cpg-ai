hf:hasPart a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "A part of the packaging, applicator or piece, visible in the photo."@en ;
    rdfs:domain hf:Furnishing ;
    rdfs:range hf:FurnitureComponent .


# ---------------------------------------------------------------- details and their allowed values

hf:Attribute a owl:Class ;
    rdfs:label "Attribute value"@en ;
    rdfs:comment "A detail of a product; each family is a subclass and each value a named individual."@en ;
    skos:prefLabel "Attribute value"@en .

hf:hasAttribute a owl:ObjectProperty ;
    rdfs:label "has attribute"@en ;
    rdfs:comment "Generic link from a product to one of its detail values; sub-properties are one per family."@en ;
    rdfs:domain hf:Furnishing ;
    rdfs:range hf:Attribute .

hf:Material a owl:Class ;
    rdfs:label "material"@en ;
    rdfs:subClassOf hf:Attribute ;
    skos:prefLabel "material"@en .

hf:hasMaterial a owl:ObjectProperty ;
    rdfs:label "hasMaterial"@en ;
    rdfs:domain hf:Furnishing ;
    rdfs:range hf:Material ;
    rdfs:subPropertyOf hf:hasAttribute .

hf:material_oak a hf:Material,
        owl:NamedIndividual ;
    rdfs:label "oak"@en ;
    skos:prefLabel "oak"@en .

