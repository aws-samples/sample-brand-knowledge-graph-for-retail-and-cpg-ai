fo:illustrates a owl:ObjectProperty ;
    rdfs:label "illustrates"@en ;
    fo:visual false ;
    rdfs:comment "What an editorial statement is about."@en ;
    rdfs:domain fo:Statement ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( fo:Look fo:Item fo:Apparel ) ] .

fo:isCategory a owl:ObjectProperty ;
    rdfs:label "is category"@en ;
    fo:visual false ;
    rdfs:comment "The apparel category of an item."@en ;
    rdfs:domain fo:Item ;
    rdfs:range fo:Apparel .

fo:layeredWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "layered with"@en ;
    fo:visual false ;
    rdfs:comment "Two items worn layered in the same look."@en ;
    rdfs:domain fo:Item ;
    rdfs:range fo:Item .

