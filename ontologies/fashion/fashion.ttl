fo:colorName a owl:DatatypeProperty ;
    rdfs:label "color"@en ;
    rdfs:domain fo:Item ;
    rdfs:range xsd:string .

fo:conceptId a owl:AnnotationProperty ;
    rdfs:label "concept id"@en ;
    rdfs:comment "Stable machine id used by the pipeline (e.g. 'coat', 'silhouette:a-line')."@en .

fo:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    fo:visual false ;
    rdfs:comment "A look contains an item."@en ;
    rdfs:domain fo:Look ;
    rdfs:range fo:Item .

fo:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:domain fo:Item ;
    rdfs:range xsd:string .

fo:for a owl:ObjectProperty ;
    rdfs:label "for"@en ;
    fo:visual true ;
    rdfs:comment "The occasion a look is worn for."@en ;
    rdfs:domain fo:Look ;
    rdfs:range fo:Occasion ;
    skos:editorialNote "Added by this sample; not part of the Fashionpedia ontology."@en .

fo:fromLine a owl:ObjectProperty ;
    rdfs:label "from line"@en ;
    fo:visual false ;
    rdfs:domain fo:Item ;
    rdfs:range fo:Line .

fo:hasAnimalMaterial a owl:ObjectProperty ;
    rdfs:label "hasAnimalMaterial"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fo:LegsAndFeetwear fo:ArmsAndHandsAccessory fo:OtherAccessory ) ] ;
    rdfs:range fo:AnimalMaterial ;
    rdfs:subPropertyOf fo:hasAttribute .

fo:hasLeatherType a owl:ObjectProperty ;
    rdfs:label "hasLeatherType"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fo:LegsAndFeetwear fo:ArmsAndHandsAccessory fo:WaistAccessory fo:OtherAccessory ) ] ;
    rdfs:range fo:LeatherType ;
    rdfs:subPropertyOf fo:hasAttribute .

fo:hasLength a owl:ObjectProperty ;
    rdfs:label "hasLength"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fo:UpperBodyGarment fo:LowerBodyGarment fo:WholeBodyGarment ) ] ;
    rdfs:range fo:Length ;
    rdfs:subPropertyOf fo:hasAttribute .

fo:hasNecklineType a owl:ObjectProperty ;
    rdfs:label "hasNecklineType"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fo:UpperBodyGarment fo:WholeBodyGarment ) ] ;
    rdfs:range fo:NecklineType ;
    rdfs:subPropertyOf fo:hasAttribute .

fo:hasNickname a owl:ObjectProperty ;
    rdfs:label "hasNickname"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fo:UpperBodyGarment fo:LowerBodyGarment fo:WholeBodyGarment fo:LegsAndFeetwear fo:Headwear ) ] ;
    rdfs:range fo:Nickname ;
    rdfs:subPropertyOf fo:hasAttribute .

fo:hasNonTextileMaterial a owl:ObjectProperty ;
    rdfs:label "hasNonTextileMaterial"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fo:LegsAndFeetwear fo:ArmsAndHandsAccessory fo:Headwear fo:WaistAccessory fo:OtherAccessory ) ] ;
    rdfs:range fo:NonTextileMaterial ;
    rdfs:subPropertyOf fo:hasAttribute .

fo:hasOpeningType a owl:ObjectProperty ;
    rdfs:label "hasOpeningType"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fo:UpperBodyGarment fo:LowerBodyGarment fo:WholeBodyGarment fo:LegsAndFeetwear ) ] ;
    rdfs:range fo:OpeningType ;
    rdfs:subPropertyOf fo:hasAttribute .

fo:hasPart a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "A garment part, closure or decoration visible on the garment."@en ;
    rdfs:domain fo:Apparel ;
    rdfs:range fo:GarmentComponent .

fo:hasSilhouette a owl:ObjectProperty ;
    rdfs:label "hasSilhouette"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fo:UpperBodyGarment fo:LowerBodyGarment fo:WholeBodyGarment ) ] ;
    rdfs:range fo:Silhouette ;
    rdfs:subPropertyOf fo:hasAttribute .

fo:hasStatement a owl:ObjectProperty ;
    rdfs:label "has statement"@en ;
    fo:visual false ;
    rdfs:domain fo:Article ;
    rdfs:range fo:Statement .

fo:hasTextileFinishing a owl:ObjectProperty ;
    rdfs:label "hasTextileFinishing"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fo:UpperBodyGarment fo:LowerBodyGarment fo:WholeBodyGarment ) ] ;
    rdfs:range fo:TextileFinishing ;
    rdfs:subPropertyOf fo:hasAttribute .

fo:hasTextilePattern a owl:ObjectProperty ;
    rdfs:label "hasTextilePattern"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fo:UpperBodyGarment fo:LowerBodyGarment fo:WholeBodyGarment fo:Neckwear fo:Headwear fo:LegsAndFeetwear ) ] ;
    rdfs:range fo:TextilePattern ;
    rdfs:subPropertyOf fo:hasAttribute .

fo:hasWaistline a owl:ObjectProperty ;
    rdfs:label "hasWaistline"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fo:LowerBodyGarment fo:WholeBodyGarment ) ] ;
    rdfs:range fo:Waistline ;
