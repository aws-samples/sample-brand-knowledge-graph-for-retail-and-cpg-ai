    skos:prefLabel "legs and feet"@en .

fo:LowerBodyGarment a owl:Class ;
    rdfs:label "Lower body"@en ;
    fo:conceptId "lowerbody" ;
    rdfs:subClassOf fo:Apparel ;
    skos:prefLabel "lowerbody"@en .

fo:Occasion a owl:Class ;
    rdfs:label "Occasion"@en ;
    fo:conceptId "occasion" ;
