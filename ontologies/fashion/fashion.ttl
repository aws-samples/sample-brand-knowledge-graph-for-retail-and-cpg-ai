fo:Article a owl:Class ;
    rdfs:label "Article"@en ;
    fo:visual false ;
    rdfs:comment "An editorial source document: magazine feature, brand blog post, lookbook text."@en .

fo:Brand a owl:Class ;
    rdfs:label "Brand"@en ;
    fo:visual false ;
    rdfs:comment "A brand (the fictional 'Velloway' in the sample data)."@en .

fo:Closure a owl:Class ;
    rdfs:label "Closures"@en ;
    fo:conceptId "closures" ;
    rdfs:subClassOf fo:GarmentComponent ;
    skos:prefLabel "closures"@en .

fo:Line a owl:Class ;
    rdfs:label "Line"@en ;
    fo:visual false ;
    rdfs:comment "A brand's product line or collection."@en .

fo:Neckwear a owl:Class ;
    rdfs:label "Neck"@en ;
    fo:conceptId "neck" ;
    rdfs:subClassOf fo:Apparel ;
    skos:prefLabel "neck"@en .

fo:Statement a owl:Class ;
    rdfs:label "Statement"@en ;
    fo:visual false ;
    rdfs:comment "A single editorial claim extracted from an article (e.g. a styling rule or trend note)."@en .

fo:Look a owl:Class ;
    rdfs:label "Look"@en ;
    fo:visual false ;
    rdfs:comment "A styled outfit: an ordered set of items shown together (lookbook, campaign, editorial)."@en .

fo:WaistAccessory a owl:Class ;
    rdfs:label "Waist"@en ;
    fo:conceptId "waist" ;
    rdfs:subClassOf fo:Apparel ;
    skos:prefLabel "waist"@en .

fo:GarmentComponent a owl:Class ;
    rdfs:label "Garment component"@en ;
    rdfs:comment "A part, closure or decoration of a garment (Fashionpedia apparel parts)."@en .

fo:ArmsAndHandsAccessory a owl:Class ;
    rdfs:label "Arms and hands"@en ;
    fo:conceptId "arms-and-hands" ;
    rdfs:subClassOf fo:Apparel ;
    skos:prefLabel "arms and hands"@en .

fo:LeatherType a owl:Class ;
    rdfs:label "leather"@en ;
    fo:conceptId "leather" ;
    rdfs:subClassOf fo:Attribute ;
    skos:prefLabel "leather"@en .

fo:Headwear a owl:Class ;
    rdfs:label "Head"@en ;
    fo:conceptId "head" ;
    rdfs:subClassOf fo:Apparel ;
    skos:prefLabel "head"@en .

fo:AnimalMaterial a owl:Class ;
    rdfs:label "animal"@en ;
    fo:conceptId "animal" ;
    rdfs:subClassOf fo:Attribute ;
