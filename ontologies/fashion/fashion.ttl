    fo:conceptId "garment-parts" ;
    rdfs:subClassOf fo:GarmentComponent ;
    skos:prefLabel "garment parts"@en .

fo:Waistline a owl:Class ;
    rdfs:label "waistline"@en ;
    fo:conceptId "waistline" ;
    rdfs:subClassOf fo:Attribute ;
    skos:prefLabel "waistline"@en .

fo:Item a owl:Class ;
    rdfs:label "Item"@en ;
    fo:visual false ;
    rdfs:comment "A concrete catalog product; its category is one of the Apparel classes."@en .

fo:Decoration a owl:Class ;
    rdfs:label "Decorations"@en ;
    fo:conceptId "decorations" ;
    rdfs:subClassOf fo:GarmentComponent ;
    skos:prefLabel "decorations"@en .

fo:LegsAndFeetwear a owl:Class ;
