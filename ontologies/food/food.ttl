    rdfs:range fb:PackagingComponent .


# ---------------------------------------------------------------- details and their allowed values

fb:Attribute a owl:Class ;
    rdfs:label "Attribute value"@en ;
    rdfs:comment "A detail of a product; each family is a subclass and each value a named individual."@en ;
    skos:prefLabel "Attribute value"@en .

fb:hasAttribute a owl:ObjectProperty ;
    rdfs:label "has attribute"@en ;
    rdfs:comment "Generic link from a product to one of its detail values; sub-properties are one per family."@en ;
    rdfs:domain fb:FoodAndDrink ;
    rdfs:range fb:Attribute .

fb:Flavor a owl:Class ;
    rdfs:label "flavor"@en ;
    rdfs:subClassOf fb:Attribute ;
    skos:prefLabel "flavor"@en .

fb:hasFlavor a owl:ObjectProperty ;
    rdfs:label "hasFlavor"@en ;
    rdfs:domain fb:FoodAndDrink ;
    rdfs:range fb:Flavor ;
    rdfs:subPropertyOf fb:hasAttribute .

