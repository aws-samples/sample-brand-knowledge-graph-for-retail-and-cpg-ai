        owl:NamedIndividual ;
    rdfs:label "Mediterranean"@en ;
    skos:prefLabel "Mediterranean"@en .

fb:cuisine_middle-eastern a fb:Cuisine,
        owl:NamedIndividual ;
    rdfs:label "Middle Eastern"@en ;
    skos:prefLabel "Middle Eastern"@en .

fb:cuisine_nordic a fb:Cuisine,
        owl:NamedIndividual ;
    rdfs:label "Nordic"@en ;
    skos:prefLabel "Nordic"@en .

fb:Body a owl:Class ;
    rdfs:label "body"@en ;
    rdfs:subClassOf fb:Attribute ;
    skos:prefLabel "body"@en .

fb:hasBody a owl:ObjectProperty ;
    rdfs:label "hasBody"@en ;
    rdfs:domain fb:Beverage ;
    rdfs:range fb:Body ;
    rdfs:subPropertyOf fb:hasAttribute .

fb:body_light a fb:Body,
        owl:NamedIndividual ;
    rdfs:label "light"@en ;
    skos:prefLabel "light"@en .

fb:body_medium a fb:Body,
        owl:NamedIndividual ;
    rdfs:label "medium"@en ;
    skos:prefLabel "medium"@en .

fb:body_full a fb:Body,
        owl:NamedIndividual ;
    rdfs:label "full"@en ;
    skos:prefLabel "full"@en .

fb:Sweetness a owl:Class ;
    rdfs:label "sweetness"@en ;
    rdfs:subClassOf fb:Attribute ;
    skos:prefLabel "sweetness"@en .

fb:hasSweetness a owl:ObjectProperty ;
    rdfs:label "hasSweetness"@en ;
    rdfs:domain fb:Beverage ;
    rdfs:range fb:Sweetness ;
    rdfs:subPropertyOf fb:hasAttribute .

fb:sweetness_dry a fb:Sweetness,
        owl:NamedIndividual ;
    rdfs:label "dry"@en ;
    skos:prefLabel "dry"@en .

fb:sweetness_off-dry a fb:Sweetness,
        owl:NamedIndividual ;
    rdfs:label "off-dry"@en ;
    skos:prefLabel "off-dry"@en .

fb:sweetness_medium-sweet a fb:Sweetness,
        owl:NamedIndividual ;
    rdfs:label "medium sweet"@en ;
    skos:prefLabel "medium sweet"@en .

fb:sweetness_sweet a fb:Sweetness,
        owl:NamedIndividual ;
    rdfs:label "sweet"@en ;
    skos:prefLabel "sweet"@en .


# ---------------------------------------------------------------- the brand graph's schema (not shown to the vision model)

fb:Spread a owl:Class ;
    rdfs:label "Spread"@en ;
    fo:visual false ;
    rdfs:comment "A styled table the brand shows: a recipe, a menu or a serving photo (food's look)."@en ;
    skos:prefLabel "Spread"@en .

fb:Item a owl:Class ;
    rdfs:label "Item"@en ;
    fo:visual false ;
    rdfs:comment "One product as it appears in a spread or a product shot."@en ;
    skos:prefLabel "Item"@en .

fb:Brand a owl:Class ;
    rdfs:label "Brand"@en ;
    fo:visual false ;
    rdfs:comment "The brand."@en ;
    skos:prefLabel "Brand"@en .

fb:Article a owl:Class ;
    rdfs:label "Article"@en ;
    fo:visual false ;
    rdfs:comment "An editorial text: a recipe, a pairing guide."@en ;
    skos:prefLabel "Article"@en .

fb:Statement a owl:Class ;
    rdfs:label "Statement"@en ;
    fo:visual false ;
    rdfs:comment "One claim of an article, about a spread or a product."@en ;
    skos:prefLabel "Statement"@en .

fb:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    fo:visual false ;
    rdfs:comment "The products in a spread."@en ;
    rdfs:domain fb:Spread ;
    rdfs:range fb:Item .

fb:isCategory a owl:ObjectProperty ;
    rdfs:label "is category"@en ;
    fo:visual false ;
    rdfs:comment "The kind of food or drink an item is."@en ;
    rdfs:domain fb:Item ;
    rdfs:range fb:FoodAndDrink .

fb:hasStatement a owl:ObjectProperty ;
    rdfs:label "has statement"@en ;
    fo:visual false ;
    rdfs:comment "The statements of an article."@en ;
    rdfs:domain fb:Article ;
    rdfs:range fb:Statement .

fb:illustrates a owl:ObjectProperty ;
    rdfs:label "illustrates"@en ;
    fo:visual false ;
    rdfs:comment "The spread a statement is about."@en ;
    rdfs:domain fb:Statement ;
    rdfs:range fb:Spread .

fb:servedWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "served with"@en ;
    fo:visual false ;
    rdfs:comment "Kind-level pairing rule: these are served together."@en ;
    rdfs:domain fb:FoodAndDrink ;
    rdfs:range fb:FoodAndDrink .


# ---------------------------------------------------------------- a few of the brand's rules, as examples

fb:Cheese fb:servedWith fb:Wine .

fb:Cheese fb:servedWith fb:Cracker .

fb:Bread fb:servedWith fb:Oil .

fb:Coffee fb:servedWith fb:Pastry .

fb:Chocolate fb:servedWith fb:Spirit .
