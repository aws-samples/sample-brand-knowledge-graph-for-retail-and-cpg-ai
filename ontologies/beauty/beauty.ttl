    rdfs:label "has part"@en ;
    rdfs:comment "A part of the packaging, applicator or piece, visible in the photo."@en ;
    rdfs:domain be:Product ;
    rdfs:range be:ProductComponent .


# ---------------------------------------------------------------- details and their allowed values

be:Attribute a owl:Class ;
    rdfs:label "Attribute value"@en ;
    rdfs:comment "A detail of a product; each family is a subclass and each value a named individual."@en ;
    skos:prefLabel "Attribute value"@en .

be:hasAttribute a owl:ObjectProperty ;
    rdfs:label "has attribute"@en ;
    rdfs:comment "Generic link from a product to one of its detail values; sub-properties are one per family."@en ;
    rdfs:domain be:Product ;
    rdfs:range be:Attribute .

be:Texture a owl:Class ;
    rdfs:label "texture"@en ;
    rdfs:subClassOf be:Attribute ;
    skos:prefLabel "texture"@en .

be:hasTexture a owl:ObjectProperty ;
    rdfs:label "hasTexture"@en ;
    rdfs:domain be:Product ;
    rdfs:range be:Texture ;
    rdfs:subPropertyOf be:hasAttribute .

be:texture_cream a be:Texture,
        owl:NamedIndividual ;
    rdfs:label "cream"@en ;
    skos:prefLabel "cream"@en .

be:texture_gel a be:Texture,
