# ---------------------------------------------------------------- the brand graph's schema (not shown to the vision model)

be:Regimen a owl:Class ;
    rdfs:label "Regimen"@en ;
    fo:visual false ;
    rdfs:comment "A routine the brand recommends: an ordered set of products for a skin type or concern (beauty's look)."@en ;
    skos:prefLabel "Regimen"@en .

be:Item a owl:Class ;
    rdfs:label "Item"@en ;
    fo:visual false ;
    rdfs:comment "One product as it appears in a regimen photo or a product shot."@en ;
    skos:prefLabel "Item"@en .

be:Brand a owl:Class ;
    rdfs:label "Brand"@en ;
    fo:visual false ;
    rdfs:comment "The brand."@en ;
    skos:prefLabel "Brand"@en .

be:Article a owl:Class ;
    rdfs:label "Article"@en ;
    fo:visual false ;
    rdfs:comment "An editorial text: a journal post, a routine guide."@en ;
    skos:prefLabel "Article"@en .

be:Statement a owl:Class ;
    rdfs:label "Statement"@en ;
    fo:visual false ;
    rdfs:comment "One claim of an article, about a regimen or a product."@en ;
    skos:prefLabel "Statement"@en .

be:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    fo:visual false ;
    rdfs:comment "The products in a regimen."@en ;
    rdfs:domain be:Regimen ;
    rdfs:range be:Item .

be:isCategory a owl:ObjectProperty ;
    rdfs:label "is category"@en ;
    fo:visual false ;
    rdfs:comment "The kind of product an item is."@en ;
    rdfs:domain be:Item ;
    rdfs:range be:Product .

be:hasStatement a owl:ObjectProperty ;
    rdfs:label "has statement"@en ;
    fo:visual false ;
    rdfs:comment "The statements of an article."@en ;
    rdfs:domain be:Article ;
    rdfs:range be:Statement .

be:illustrates a owl:ObjectProperty ;
    rdfs:label "illustrates"@en ;
    fo:visual false ;
    rdfs:comment "The regimen a statement is about."@en ;
    rdfs:domain be:Statement ;
    rdfs:range be:Regimen .

be:appliedBefore a owl:ObjectProperty ;
    rdfs:label "applied before"@en ;
    fo:visual false ;
    rdfs:comment "Routine order at the kind level: a cleanser goes on before a toner, a serum before a moisturizer."@en ;
    rdfs:domain be:Product ;
    rdfs:range be:Product .

be:conflictsWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "conflicts with"@en ;
    fo:visual false ;
    rdfs:comment "Ingredients the brand does not combine in one routine step."@en ;
    rdfs:domain be:KeyIngredient ;
    rdfs:range be:KeyIngredient .


# ---------------------------------------------------------------- a few of the brand's rules, as examples

be:Cleanser be:appliedBefore be:Toner .

be:Toner be:appliedBefore be:Serum .

be:Serum be:appliedBefore be:Moisturizer .

be:Moisturizer be:appliedBefore be:Sunscreen .

be:Sunscreen be:appliedBefore be:Primer .

be:Primer be:appliedBefore be:Foundation .

be:key-ingredient_retinol be:conflictsWith be:key-ingredient_glycolic-acid .

be:key-ingredient_retinol be:conflictsWith be:key-ingredient_salicylic-acid .

be:key-ingredient_retinol be:conflictsWith be:key-ingredient_benzoyl-peroxide .

be:key-ingredient_vitamin-c be:conflictsWith be:key-ingredient_benzoyl-peroxide .
